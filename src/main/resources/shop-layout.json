{
	"_comment": [
		"How the shop screen is arranged. Presentation only: not one price, level or ceiling is here,",
		"and nothing reads this on the server. The catalogue itself is default-balance.json.",
		"",
		"Groups are matched in order and an offer joins the first group whose prefixes it starts with,",
		"so 'player.slot.' has to come before 'player.'. The last group matches the empty prefix, which",
		"means a catalogue entry nobody has placed yet still shows up somewhere rather than vanishing.",
		"",
		"Tiers are drawn in the order they first appear below, and 'vanilla' appearing first is the",
		"visual hierarchy the design asks for: restoring vanilla comes before going past it."
	],

	"defaultIcon": "minecraft:paper",

	"groups": [
		{ "id": "world", "tier": "vanilla", "prefixes": ["world.trees", "world.village"] },
		{ "id": "border", "tier": "vanilla", "prefixes": ["world.border."] },
		{ "id": "ores", "tier": "vanilla", "prefixes": ["world.ore."] },
		{ "id": "animals", "tier": "vanilla", "prefixes": ["world.animal."] },
		{ "id": "slots", "tier": "vanilla", "prefixes": ["player.slot."] },
		{ "id": "gear", "tier": "vanilla_plus", "prefixes": ["starter."] },
		{ "id": "upgrades", "tier": "vanilla_plus", "prefixes": ["player."] },
		{ "id": "other", "tier": "vanilla_plus", "prefixes": [""] }
	],

	"icons": {
